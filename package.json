{
  "name": "digitalora-shop-bot",
  "version": "1.0.0",
  "description": "Futuristic Telegram Shop Bot for @digitalorashopbot \u2014 config-driven, Supabase-backed, multi-language.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build",
    "test:payment-hardening": "node tests/payment-gateway-hardening.test.mjs",
    "test:ui": "node tests/ui-professionalization.test.mjs"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.0.0",
    "@grammyjs/i18n": "^1.1.0",
    "@grammyjs/menu": "^1.3.0",
    "@grammyjs/parse-mode": "^1.11.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.18.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "resend": "^6.12.2",
    "undici": "^8.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2"
  }
}
